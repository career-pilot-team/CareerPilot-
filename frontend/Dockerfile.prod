# 1) 빌드 스테이지: Vite로 정적 파일 빌드
FROM node:20-alpine AS builder

WORKDIR /app

# 의존성 설치
COPY package*.json ./
RUN npm install

# 소스 복사
COPY . .

# Vite 빌드 (dist 폴더 생성)
RUN npm run build

# 2) 런타임 스테이지: 가벼운 Node 서버로 dist 서빙
FROM node:20-alpine

WORKDIR /app

# 정적 파일 서버 설치 (serve 사용)
RUN npm install -g serve

# 빌드 결과만 가져오기
COPY --from=builder /app/dist ./dist

# 3000 포트에서 정적 파일 서빙
EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
